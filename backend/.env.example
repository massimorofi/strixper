# Halogen Strix Halo Operations Dashboard -- backend settings
# Copy to .env and adjust.

# Halogen LLM server base address.
# This is only the STARTING value. The dashboard follows whichever engine
# you last started through the LLM-Runner and remembers that choice in
# data/engine_target.json, so this is used just until the first run (or a
# manual POST /api/v1/config {"halogen_host": "..."}).
HALOGEN_HOST=http://127.0.0.1:8731

# Background polling cadence in seconds (default 5)
POLL_INTERVAL_SECONDS=5

# Backend bind address
BIND_HOST=0.0.0.0
BIND_PORT=8000

# Where the remembered engine target is stored
# (default: backend/data/engine_target.json)
# ENGINE_TARGET_PATH=/absolute/path/to/engine_target.json

# Model id assumed before any engine reports one. Overridden by a run
# configuration's `served_model_name`, and by the engine's own /health.
# DEFAULT_MODEL=halogen-qwen3.8-flash-next

# ---- LLM-Runner run lifecycle -------------------------------------------
# A run is a server-side resource: it keeps running when every browser
# closes, and any browser can watch or stop it.

# Seconds `docker stop` waits for a container before force-killing it
# (default 5)
# RUNNER_STOP_TIMEOUT=5

# Console history kept for late-joining viewers, in bytes
# (default 2097152 = 2 MiB, roughly 8h of a busy engine's logging)
# RUNNER_CONSOLE_BYTES=2097152

# Per-viewer output queue depth; a viewer that falls behind sheds its own
# oldest chunks rather than being dropped
# RUNNER_SUBSCRIBER_QUEUE=2000

# Lines of `docker logs` pulled when adopting an already-running container
# RUNNER_ADOPT_TAIL=2000

# Seconds to wait for a stopped container's port/GPU to actually be
# released before starting the next one
# RUNNER_RELEASE_WAIT=20

# Seconds a stop waits for the output pump to record the exit itself
# RUNNER_STOP_SETTLE=15

# Seconds of silence before a console stream sends a keepalive frame
# RUNNER_SSE_HEARTBEAT=15

# Seconds between scans for an engine container we are not tracking
# RUNNER_RECONCILE=20

# ---- AI Chat (agentic mode) ---------------------------------------------
# The AI Chat tab can run in two modes, chosen per message in the UI:
#   Plain   -- one-shot chat completion (POST /api/v1/chat)
#   Agent   -- OpenAI Agents SDK loop with dashboard tools
#             (POST /api/v1/agent/chat)
# Neither mode needs an OpenAI account: both talk to your local Halogen
# engine through its OpenAI-compatible endpoint.

# Maximum number of agent turns (model call + tool calls) before the run
# is aborted. Guards against a model that keeps calling tools forever.
# (default 8)
# AGENT_MAX_TURNS=8

# Optional override of the agent's system prompt. Leave unset to use the
# built-in instructions, which describe the Strix Halo dashboard, the
# available tools, and when to use them.
# AGENT_INSTRUCTIONS=You are a helpful assistant for an AMD Strix Halo box.
